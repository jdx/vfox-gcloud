amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["lua-check"] {
        glob = "**/*.lua"
        check = "lua-language-server --check ."
    }
    ["stylua"] {
        glob = "**/*.lua"
        check = "stylua --check {{files}}"
        fix = "stylua {{files}}"
    }
    // lints GitHub Actions workflows (jdx/jactionlint, a maintained actionlint fork)
    ["jactionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        batch = true
        check = new CommandSpec {
            command = "jactionlint {{ files }}"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "jactionlint --fix {{ files }}"
            effect = "write"
        }
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
